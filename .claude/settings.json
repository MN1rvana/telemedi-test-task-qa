{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "claudeMdExcludes": ["**/.claude/CLAUDE.md", "**/.claude/rules/**"],
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/playwright/.auth/**)",
      "Read(**/playwright-report/**)",
      "Read(**/test-results/**/*.zip)",
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Drive",
      "mcp__claude_ai_Google_Calendar",
      "mcp__claude_ai_Claude_Docs",
      "mcp__claude-in-chrome"
    ],
    "ask": [
      "Bash(git init:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git remote add:*)",
      "Bash(gh repo create:*)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(package.json)",
      "Write(package.json)",
      "Edit(scripts/**)",
      "Write(scripts/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["npm test *"],
    "filesystem": {
      "denyRead": [".env"]
    },
    "network": {
      "allowedDomains": [
        "testyautomatyczne.telemedi.com",
        "*.telemedi.com",
        "registry.npmjs.org",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-paths.mjs\" || exit 2"
          }
        ]
      }
    ]
  }
}
